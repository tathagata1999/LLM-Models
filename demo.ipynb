from openai import OpenAI
from IPython.display import display, Markdown

client = OpenAI()

open_ai_model1 = "gpt-4.1"
open_ai_model2 = "gpt-5"

model1_msgs = ["hi"]
model2_msgs = ["hi there"]

openai1_system_prompt = "You are a very supportive assistant who listens and replies politely."
openai2_system_prompt = "You are a very strict assistant."

def open_ai1():
    messages = [{"role": "system", "content": openai1_system_prompt}]

    for m1, m2 in zip(model1_msgs, model2_msgs):
        messages.append({"role": "user", "content": m2})
        messages.append({"role": "assistant", "content": m1})

    response = client.chat.completions.create(
        model=open_ai_model1,
        messages=messages
    )
    return response.choices[0].message.content


def open_ai2():
    messages = [{"role": "system", "content": openai2_system_prompt}]

    for m1, m2 in zip(model1_msgs, model2_msgs):
        messages.append({"role": "user", "content": m1})
        messages.append({"role": "assistant", "content": m2})

    response = client.chat.completions.create(
        model=open_ai_model2,
        messages=messages
    )
    return response.choices[0].message.content


display(Markdown(f"### GPT1 start: {model1_msgs[-1]}"))
display(Markdown(f"### GPT2 start: {model2_msgs[-1]}"))

for i in range(5):
    sys1 = open_ai1()
    model1_msgs.append(sys1)
    display(Markdown(f"### GPT1: {sys1}"))

    sys2 = open_ai2()
    model2_msgs.append(sys2)
    display(Markdown(f"### GPT2: {sys2}"))
